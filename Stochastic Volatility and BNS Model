    args = (a, b, sigma, r, q, lamb, rho, T, S0)
    numerator = np.exp(r*T)*cf_bns(phi-1j,*args) - K*cf_bns(phi,*args)
    #denominator = 1j*phi*K**(1j*phi)
    denominator = 1j*phi*np.exp(1j*phi*np.log(K))
    return numerator/denominator

def heston_price_rec(a, b, sigma, r, q, lamb, rho, T, S0, K, flag):
    args = (a, b, sigma, r, q, lamb, rho, T, S0)
    P, umax, N = 0, 100, 10000
    dphi=umax/N #dphi is width

    for i in range(1,N):
        # rectangular integration
        phi = dphi * (2*i + 1)/2 # midpoint to calculate height
        numerator = np.exp(r*T)*cf_bns(phi-1j,*args) - K * cf_bns(phi,*args)
        #denominator = 1j*phi*np.exp(1j*phi*np.log(K))
        denominator = 1j*phi*K**(1j*phi)
        P += dphi * numerator/denominator

    call = np.real((S0 - K*np.exp(-r*T))/2 + P/np.pi)
    put = call - S0 + K * np.exp(-r * T)
    return call if flag == 'Call' else put

def heston_price_rec_vector(a, b, sigma, r, q, lamb, rho, T, S0_list, K_list, flag_list):
    prices = []
    for S0, K, T, flag in zip(S0_list, K_list, T, flag_list):
        # Call the original scalar version of heston_price_rec for each option
        price = heston_price_rec(a, b, sigma, r, q, lamb, rho, T, S0, K, flag)
        prices.append(price)
    return np.array(prices)

