            else:
                sequences.append(current_sequence)  # Sequence ends, save it
                current_sequence = [lst[i]]  # Start a new sequence with the current element

        sequences.append(current_sequence)  # Append the last sequence

        # Calculate the average of each sequence
        averages = [sum(seq) / len(seq) for seq in sequences]

