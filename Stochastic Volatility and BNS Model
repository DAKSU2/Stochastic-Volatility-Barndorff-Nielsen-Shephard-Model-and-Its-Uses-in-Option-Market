    def simulate_poisson_process(rate, time_horizon):
        event_times = []
        current_time = 0
        while current_time < time_horizon:
            # Generate the time until the next event, which follows an exponential distribution
            time_until_next_event = np.random.exponential(1/rate)
            current_time += time_until_next_event

            if current_time < time_horizon:
                event_times.append(current_time)
        return event_times

