def cf_bns(u, a, b, sigma, r, q, lamb, rho, T, S0):
    q = 0.0032
    f = 1j * u * rho - 0.5 * (u**2 + 1j * u) * (1 - np.exp(-lamb * T))
    ff = 1j * u * rho - 0.5 * (u**2 + 1j * u)
    
    # Stabilize complex exponentials
    safe_lamb = max(lamb, 1e-6)
    safe_b = max(b, rho + 1e-6)
    
    # Avoid direct complex power
    lamb_term = np.exp(-1j * np.log(safe_lamb))
    #pow_term = np.exp(-1j * np.log(safe_b - ff))
    
    #NN = np.exp(1j * u * (np.log(S0) + (r - q - a * lamb * rho / (safe_b - rho)) * T))
    NN = np.exp(1j * u * (np.log(S0) + (r - q - a * lamb * rho / (b - rho)) * T))
    #MM = np.exp(-0.5 * (1/lamb_term) * (u**2 + 1j * u) * (1 - np.exp(-safe_lamb * T)) * sigma**2)
    MM = np.exp(-0.5 * (1/lamb) * (u**2 + 1j * u) * (1 - np.exp(-lamb * T)) * sigma**2)

    log_arg = (b - f) / (b - 1j * u * rho)
    #log_arg = np.where(np.real(log_arg) <= 0, 1, log_arg)  # avoid log of negative
    #RR = np.exp(a * (1/(safe_b - ff)) * (safe_b * np.log(log_arg) + ff * safe_lamb * T))
    RR = np.exp(a * (1/(b - ff)) * (b * np.log(log_arg) + ff * lamb * T))

    cf = NN * MM * RR
    return cf

